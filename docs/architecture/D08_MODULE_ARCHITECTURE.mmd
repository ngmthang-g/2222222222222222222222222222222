subgraph EMU["Emulator subsystem"]
  EINPUT[emu_input]:::guest
  EREADER[emu_reader / manager]:::guest
  EREMOTE[emu_remote]:::guest
  ESETUP[emu_setup]:::guest
  ECHAT[emu_chat]:::guest
  EFARM[emu_farm_tab]:::guest
  EDEBUG[debug_android_tab]:::guest
  FRIDA[guest frida-server]:::helper
  EMUJS[emu_client.js
Frida RPC]:::helper
  LDJS[ld_remote.js
AutoX floaty]:::helper
