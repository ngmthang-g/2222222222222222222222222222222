subgraph DATA["Config / state"]
  SETTINGS[%APPDATA%/TLMTool/settings.ini]:::data
  CONFIG[config.ini contexts]:::data
  LOGINSTATE[login_online.json
last_login_times.json]:::data
  LOGS[tlmtool.log / tlm_memory.log
automove_log.txt]:::data
